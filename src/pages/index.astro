---
import { mdiAirplane, mdiLoading, mdiMapOutline } from "@mdi/js";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { Og } from "@utils/og.ts";

const TITLE = "Veskovo čtverečky";
const OG: Og = {
    type: "website",
    // image: {
    //     url: "TODO",
    //     width: 1200,
    //     height: 630,
    //     type: "image/webp",
    //     alt: "TODO",
    // },
};
---

<BaseLayout title={TITLE} og={OG}>
    <h1 class="sr-only">Veskovo čtverečky</h1>
    <div class="relative size-full">
        <div id="map-canvas" class="size-full"></div>
        <button
            id="basemap-toggle"
            type="button"
            class="maplibregl-ctrl invisible inline-flex min-h-6 items-center gap-2 rounded-lg bg-white px-2.5 py-1.5 text-[#011e39]/60 shadow-[0_4px_16px_rgba(0,0,0,0.1)]"
        >
            <svg
                id="basemap-icon-aerial"
                class="size-6"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
            >
                <path d={mdiAirplane}></path>
            </svg>
            <svg
                id="basemap-icon-outdoor"
                class="hidden size-6"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
            >
                <path d={mdiMapOutline}></path>
            </svg>
            <span id="basemap-toggle-label">Letecká</span>
        </button>
        <div
            id="stale-badge"
            role="status"
            class="maplibregl-ctrl hidden min-h-6 items-center gap-2 rounded-lg bg-white px-2.5 py-1.5 text-[#011e39]/60 shadow-[0_4px_16px_rgba(0,0,0,0.1)]"
        >
            <span>Data nemusí být aktuální</span>
            <span id="stale-countdown"></span>
            <button
                id="stale-retry"
                type="button"
                class="underline disabled:no-underline disabled:opacity-50"
            >
                Zkusit hned
            </button>
        </div>
        <div
            id="loading-badge"
            role="status"
            class="maplibregl-ctrl hidden min-h-6 items-center gap-2 rounded-lg bg-white px-2.5 py-1.5 text-[#011e39]/60 shadow-[0_4px_16px_rgba(0,0,0,0.1)]"
        >
            <svg
                class="size-6 animate-spin"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
            >
                <path d={mdiLoading}></path>
            </svg>
            <span>Načítám čtverečky…</span>
        </div>
        <a
            class="absolute bottom-1 left-1 z-10"
            href="https://mapy.com/"
            target="_blank"
        >
            <img
                src="https://api.mapy.com/img/api/logo.svg"
                alt="Mapy.com"
                width="100"
                height="30"
            />
        </a>
    </div>
</BaseLayout>

<script>
    import {
        GeolocateControl,
        Map,
        setWorkerUrl,
        type GeoJSONSource,
        type IControl,
        type RasterTileSource,
    } from "maplibre-gl";
    // MapLibre resolves its worker at runtime from import.meta.url, which no
    // bundler can see — point it at the chunk Vite actually emits.
    import workerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";
    import { fillPaint, linePaint } from "@utils/featureStyles";

    const DEFAULT_VIEW = { x: 15.0543, y: 50.7663, z: 10 };
    const STORAGE_KEY = "ctverecky:mapView";
    const BASEMAP_KEY = "ctverecky:basemap";
    const COORD_DECIMALS = 5;

    type Basemap = "outdoor" | "aerial";

    // The control names the basemap a click switches *to*.
    const BASEMAP_LABEL: Record<Basemap, string> = {
        outdoor: "Letecká",
        aerial: "Turistická",
    };

    const tileUrl = (set: Basemap) =>
        `https://api.mapy.com/v1/maptiles/${set}/256/{z}/{x}/{y}?apikey=${import.meta.env.PUBLIC_MAPY_COM_API_KEY}`;

    function basemapFromStorage(): Basemap {
        try {
            return localStorage.getItem(BASEMAP_KEY) === "aerial"
                ? "aerial"
                : "outdoor";
        } catch {
            return "outdoor";
        }
    }

    type View = { x: number; y: number; z: number };

    function parseView(
        x: string | number | null | undefined,
        y: string | number | null | undefined,
        z: string | number | null | undefined,
    ): View | null {
        const nx = typeof x === "string" ? parseFloat(x) : x;
        const ny = typeof y === "string" ? parseFloat(y) : y;
        const nz = typeof z === "string" ? parseFloat(z) : z;
        if (
            nx == null ||
            ny == null ||
            nz == null ||
            !Number.isFinite(nx) ||
            !Number.isFinite(ny) ||
            !Number.isFinite(nz) ||
            nx < -180 ||
            nx > 180 ||
            ny < -90 ||
            ny > 90 ||
            nz < 0 ||
            nz > 19
        ) {
            return null;
        }
        return { x: nx, y: ny, z: nz };
    }

    function viewFromUrl(): View | null {
        const p = new URLSearchParams(window.location.search);
        if (!p.has("x") && !p.has("y") && !p.has("z")) return null;
        return parseView(p.get("x"), p.get("y"), p.get("z"));
    }

    function viewFromStorage(): View | null {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (!raw) return null;
            const obj = JSON.parse(raw);
            return parseView(obj?.x, obj?.y, obj?.z);
        } catch {
            return null;
        }
    }

    setWorkerUrl(workerUrl);

    const initialView = viewFromUrl() ?? viewFromStorage() ?? DEFAULT_VIEW;
    let basemap = basemapFromStorage();

    const map = new Map({
        container: "map-canvas",
        center: [initialView.x, initialView.y],
        zoom: initialView.z,
        minZoom: 0,
        maxZoom: 19,
        // Merged over MapLibre's English defaults; only strings this page shows.
        locale: {
            "AttributionControl.ToggleAttribution": "Přepnout autorství",
            "AttributionControl.MapFeedback": "Zpětná vazba k mapě",
            "GeolocateControl.FindMyLocation": "Zobrazit mou polohu",
            "GeolocateControl.LocationNotAvailable": "Poloha není dostupná",
            "Map.Title": "Mapa",
        },
        dragRotate: false,
        pitchWithRotate: false,
        touchPitch: false,
        style: {
            version: 8,
            sources: {
                mapy: {
                    type: "raster",
                    tiles: [tileUrl(basemap)],
                    tileSize: 256,
                    minzoom: 0,
                    maxzoom: 19,
                    attribution:
                        '<a href="https://api.mapy.com/copyright" target="_blank">&copy; Seznam.cz a.s. a další</a>',
                },
            },
            layers: [{ id: "mapy", type: "raster", source: "mapy" }],
        },
    });
    map.touchZoomRotate.disableRotation();

    const toggle = document.getElementById("basemap-toggle")!;
    const toggleLabel = document.getElementById("basemap-toggle-label")!;

    const toggleIcon: Record<Basemap, HTMLElement> = {
        outdoor: document.getElementById("basemap-icon-aerial")!,
        aerial: document.getElementById("basemap-icon-outdoor")!,
    };

    function renderToggle() {
        // Markup ships it invisible: the stored basemap is only known here, so
        // revealing it now avoids a flash of the wrong label.
        toggle.classList.remove("invisible");
        toggleLabel.textContent = BASEMAP_LABEL[basemap];
        // Icon matches the label: plane for "Letecká", footprints for "Turistická".
        toggleIcon.outdoor.classList.toggle("hidden", basemap !== "outdoor");
        toggleIcon.aerial.classList.toggle("hidden", basemap !== "aerial");
    }

    renderToggle();
    toggle.addEventListener("click", () => {
        basemap = basemap === "outdoor" ? "aerial" : "outdoor";
        (map.getSource("mapy") as RasterTileSource).setTiles([
            tileUrl(basemap),
        ]);
        renderToggle();
        try {
            localStorage.setItem(BASEMAP_KEY, basemap);
        } catch {
            // ignore quota / privacy mode errors
        }
    });

    const geolocate = new GeolocateControl({
        trackUserLocation: true,
        // Shallow-merged over the defaults, so timeout has to be respelled. A
        // fix a few seconds old is fine for a dot on a map; the default
        // `maximumAge: 0` re-wakes the GPS every tick.
        positionOptions: {
            enableHighAccuracy: false,
            maximumAge: 5000,
            timeout: 6000,
        },
    });

    const badge = document.getElementById("stale-badge")!;
    const loadingBadge = document.getElementById("loading-badge")!;

    // The elements carry `maplibregl-ctrl` in markup: corner containers are
    // pointer-events:none, and that class switches their children back on.
    const asControl = (element: HTMLElement): IControl => ({
        onAdd: () => element,
        onRemove: () => element.remove(),
    });

    for (const control of [
        asControl(toggle),
        geolocate,
        asControl(badge),
        asControl(loadingBadge),
    ]) {
        map.addControl(control, "top-left");
    }

    function currentView(): View {
        const c = map.getCenter();
        return {
            x: parseFloat(c.lng.toFixed(COORD_DECIMALS)),
            y: parseFloat(c.lat.toFixed(COORD_DECIMALS)),
            z: parseFloat(map.getZoom().toFixed(2)),
        };
    }

    function urlView(): View | null {
        const p = new URLSearchParams(window.location.search);
        return parseView(p.get("x"), p.get("y"), p.get("z"));
    }

    function viewsEqual(a: View | null, b: View | null): boolean {
        return (
            a != null && b != null && a.x === b.x && a.y === b.y && a.z === b.z
        );
    }

    let syncTimer: ReturnType<typeof setTimeout> | null = null;
    let suppressSync = false;

    function writeView(v: View, method: "push" | "replace") {
        const params = new URLSearchParams(window.location.search);
        params.set("x", String(v.x));
        params.set("y", String(v.y));
        params.set("z", String(v.z));
        const url = `${window.location.pathname}?${params.toString()}`;
        if (method === "push") history.pushState(null, "", url);
        else history.replaceState(null, "", url);
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(v));
        } catch {
            // ignore quota / privacy mode errors
        }
    }

    writeView(currentView(), "replace");

    function scheduleSync() {
        if (suppressSync) return;
        if (syncTimer != null) clearTimeout(syncTimer);
        syncTimer = setTimeout(() => {
            syncTimer = null;
            const v = currentView();
            if (viewsEqual(v, urlView())) return;
            writeView(v, "push");
        }, 200);
    }

    map.on("moveend", scheduleSync);

    window.addEventListener("popstate", () => {
        const v = urlView();
        if (!v) return;
        if (viewsEqual(v, currentView())) return;
        suppressSync = true;
        map.jumpTo({ center: [v.x, v.y], zoom: v.z });
        suppressSync = false;
        if (syncTimer != null) {
            clearTimeout(syncTimer);
            syncTimer = null;
        }
    });

    // Overlay last: a failing /api/squares must not take the map with it.
    const BACKOFF = [2000, 4000, 8000, 15000, 30000, 60000];

    const countdown = document.getElementById("stale-countdown")!;
    const retryButton = document.getElementById(
        "stale-retry",
    ) as HTMLButtonElement;

    let backoffStep = 0;
    let retryTimer: ReturnType<typeof setTimeout> | null = null;
    let tickTimer: ReturnType<typeof setInterval> | null = null;
    let nextAttemptAt = 0;
    let inFlight = false;
    let hasData = false;

    // @types/geojson is not global here; borrow the shape maplibre accepts.
    type GeoJson = Exclude<Parameters<GeoJSONSource["setData"]>[0], string>;

    type Squares = { geojson: GeoJson; stale: boolean };

    function showBadge(element: HTMLElement, visible: boolean) {
        element.classList.toggle("hidden", !visible);
        element.classList.toggle("flex", visible);
    }

    async function loadSquares(bust: boolean): Promise<Squares | null> {
        // The cold-start scrape needs a real browser upstream, so this is slow
        // often enough to deserve a spinner.
        showBadge(badge, false);
        showBadge(loadingBadge, true);
        // Cache-busted on retries so neither the CDN nor the browser can hand
        // back the stale body we are trying to get past.
        const url = bust ? `/api/squares?t=${Date.now()}` : "/api/squares";
        try {
            const response = await fetch(url);
            if (!response.ok) return null;
            return {
                geojson: await response.json(),
                stale: response.headers.get("X-Squares-Stale") === "1",
            };
        } catch {
            return null;
        } finally {
            showBadge(loadingBadge, false);
        }
    }

    function renderCountdown() {
        if (inFlight) {
            countdown.textContent = "· ověřuji…";
            return;
        }
        const seconds = Math.max(
            0,
            Math.ceil((nextAttemptAt - Date.now()) / 1000),
        );
        countdown.textContent = `· nový pokus za ${seconds} s`;
    }

    function stopRetrying() {
        if (retryTimer != null) clearTimeout(retryTimer);
        if (tickTimer != null) clearInterval(tickTimer);
        retryTimer = null;
        tickTimer = null;
        showBadge(badge, false);
    }

    function scheduleRetry() {
        showBadge(badge, true);

        const delay =
            BACKOFF[Math.min(backoffStep, BACKOFF.length - 1)] ?? 60000;
        nextAttemptAt = Date.now() + delay;

        if (retryTimer != null) clearTimeout(retryTimer);
        retryTimer = setTimeout(attempt, delay);

        if (tickTimer == null) tickTimer = setInterval(renderCountdown, 1000);
        renderCountdown();
    }

    function applySquares(geojson: GeoJson) {
        if (hasData) {
            (map.getSource("squares") as GeoJSONSource).setData(geojson);
            return;
        }
        map.addSource("squares", { type: "geojson", data: geojson });
        map.addLayer({
            id: "squares-fill",
            type: "fill",
            source: "squares",
            paint: fillPaint(),
        });
        map.addLayer({
            id: "squares-line",
            type: "line",
            source: "squares",
            paint: linePaint(),
        });
        hasData = true;
    }

    async function attempt() {
        if (inFlight) return;

        // Don't burn Browserbase credits polling from a background tab; the
        // visibilitychange handler picks it back up.
        if (document.visibilityState === "hidden") {
            scheduleRetry();
            return;
        }

        inFlight = true;
        retryButton.disabled = true;
        renderCountdown();

        const result = await loadSquares(true);

        inFlight = false;
        retryButton.disabled = false;

        if (result) applySquares(result.geojson);

        if (result && !result.stale) {
            stopRetrying();
            return;
        }

        // A manual retry deliberately does not reset the backoff, so holding
        // the button down cannot hammer the scrape.
        backoffStep++;
        scheduleRetry();
    }

    retryButton.addEventListener("click", () => {
        if (inFlight) return;
        if (retryTimer != null) clearTimeout(retryTimer);
        retryTimer = null;
        attempt();
    });

    document.addEventListener("visibilitychange", () => {
        if (
            document.visibilityState === "visible" &&
            !inFlight &&
            retryTimer != null &&
            nextAttemptAt <= Date.now()
        ) {
            clearTimeout(retryTimer);
            retryTimer = null;
            attempt();
        }
    });

    const [squares] = await Promise.all([loadSquares(false), map.once("load")]);

    if (squares) applySquares(squares.geojson);
    if (!squares || squares.stale) scheduleRetry();
</script>

<style is:global>
    /* Unlayered, so these beat MapLibre's stylesheet (in the `maplibre` layer,
       see global.css) without extra specificity. */

    /* The corner container carries the row layout, the page inset, and the
       page's type (the map container sets a 12px font of its own). */
    .maplibregl-ctrl-top-left {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        box-sizing: border-box;
        padding: var(--spacing-gutter);
        max-width: 100%;
        font: 1rem / 1.666 var(--font-sans);
    }

    /* Controls self-float and self-margin; the flex row owns spacing instead. */
    .maplibregl-ctrl-top-left .maplibregl-ctrl {
        float: none;
        margin: 0;
    }

    /* Match the app's button skin: rounded-lg, soft shadow, and the same 36px
       box the other buttons use. The icon stays MapLibre's own — it colours
       itself per state (active, error, background-error, disabled). */
    .maplibregl-ctrl-group {
        box-shadow: 0 4px 16px rgb(0 0 0 / 0.1);
        border-radius: 0.5rem;
    }

    /* Square, and the same box as the text buttons: a 1.666 line-box plus
       their p-1.5. Deriving it from the stretched row height instead is
       cyclic — the group contributes no intrinsic width and collapses. */
    .maplibregl-ctrl-group button {
        width: calc(1.666rem + 0.75rem);
        height: calc(1.666rem + 0.75rem);
    }

    /* The stock icon is a 29px SVG in a 36px box; give it a little more room. */
    .maplibregl-ctrl-group button .maplibregl-ctrl-icon {
        background-size: 2rem;
    }

    /* The stock icon ships as flat #333 (and a light #33b5e5 when active);
       filter it to the same ink the basemap toggle uses, and darken the
       active blue, which is too pale to read on white. */
    .maplibregl-ctrl-geolocate:where(:not(:disabled)) .maplibregl-ctrl-icon {
        filter: opacity(0.6);
    }

    .maplibregl-ctrl-geolocate-active .maplibregl-ctrl-icon,
    .maplibregl-ctrl-geolocate-background .maplibregl-ctrl-icon {
        filter: brightness(0.8);
    }
</style>
