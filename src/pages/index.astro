---
import { mdiAirplane, mdiMapOutline } from "@mdi/js";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { Og } from "@utils/og.ts";

const TITLE = "Veskovo čtverečky";
const OG: Og = {
    type: "website",
    // image: {
    //     url: "TODO",
    //     width: 1200,
    //     height: 630,
    //     type: "image/webp",
    //     alt: "TODO",
    // },
};
---

<BaseLayout title={TITLE} og={OG}>
    <h1 class="sr-only">Veskovo čtverečky</h1>
    <div class="relative size-full">
        <div id="map-canvas" class="size-full"></div>
        <button
            id="basemap-toggle"
            type="button"
            class="invisible absolute top-4 left-4 z-10 inline-flex min-h-6 items-center gap-2 rounded-lg bg-white px-2.5 py-1.5 text-[#011e39]/60 shadow-[0_4px_16px_rgba(0,0,0,0.1)]"
        >
            <svg
                id="basemap-icon-aerial"
                class="size-6"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
            >
                <path d={mdiAirplane}></path>
            </svg>
            <svg
                id="basemap-icon-outdoor"
                class="hidden size-6"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
            >
                <path d={mdiMapOutline}></path>
            </svg>
            <span id="basemap-toggle-label">Letecká</span>
        </button>
        <a
            class="absolute bottom-1 left-1 z-10"
            href="https://mapy.com/"
            target="_blank"
        >
            <img
                src="https://api.mapy.com/img/api/logo.svg"
                alt="Mapy.com"
                width="100"
                height="30"
            />
        </a>
    </div>
</BaseLayout>

<script>
    import { Map, setWorkerUrl, type RasterTileSource } from "maplibre-gl";
    import "maplibre-gl/dist/maplibre-gl.css";
    // MapLibre resolves its worker at runtime from import.meta.url, which no
    // bundler can see — point it at the chunk Vite actually emits.
    import workerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";
    import { fillPaint, linePaint } from "@utils/featureStyles";

    const DEFAULT_VIEW = { x: 15.0543, y: 50.7663, z: 10 };
    const STORAGE_KEY = "ctverecky:mapView";
    const BASEMAP_KEY = "ctverecky:basemap";
    const COORD_DECIMALS = 5;

    type Basemap = "outdoor" | "aerial";

    // The control names the basemap a click switches *to*.
    const BASEMAP_LABEL: Record<Basemap, string> = {
        outdoor: "Letecká",
        aerial: "Turistická",
    };

    const tileUrl = (set: Basemap) =>
        `https://api.mapy.com/v1/maptiles/${set}/256/{z}/{x}/{y}?apikey=${import.meta.env.PUBLIC_MAPY_COM_API_KEY}`;

    function basemapFromStorage(): Basemap {
        try {
            return localStorage.getItem(BASEMAP_KEY) === "aerial"
                ? "aerial"
                : "outdoor";
        } catch {
            return "outdoor";
        }
    }

    type View = { x: number; y: number; z: number };

    function parseView(
        x: string | number | null | undefined,
        y: string | number | null | undefined,
        z: string | number | null | undefined,
    ): View | null {
        const nx = typeof x === "string" ? parseFloat(x) : x;
        const ny = typeof y === "string" ? parseFloat(y) : y;
        const nz = typeof z === "string" ? parseFloat(z) : z;
        if (
            nx == null ||
            ny == null ||
            nz == null ||
            !Number.isFinite(nx) ||
            !Number.isFinite(ny) ||
            !Number.isFinite(nz) ||
            nx < -180 ||
            nx > 180 ||
            ny < -90 ||
            ny > 90 ||
            nz < 0 ||
            nz > 19
        ) {
            return null;
        }
        return { x: nx, y: ny, z: nz };
    }

    function viewFromUrl(): View | null {
        const p = new URLSearchParams(window.location.search);
        if (!p.has("x") && !p.has("y") && !p.has("z")) return null;
        return parseView(p.get("x"), p.get("y"), p.get("z"));
    }

    function viewFromStorage(): View | null {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (!raw) return null;
            const obj = JSON.parse(raw);
            return parseView(obj?.x, obj?.y, obj?.z);
        } catch {
            return null;
        }
    }

    setWorkerUrl(workerUrl);

    const initialView = viewFromUrl() ?? viewFromStorage() ?? DEFAULT_VIEW;
    let basemap = basemapFromStorage();

    const map = new Map({
        container: "map-canvas",
        center: [initialView.x, initialView.y],
        zoom: initialView.z,
        minZoom: 0,
        maxZoom: 19,
        dragRotate: false,
        pitchWithRotate: false,
        touchPitch: false,
        style: {
            version: 8,
            sources: {
                mapy: {
                    type: "raster",
                    tiles: [tileUrl(basemap)],
                    tileSize: 256,
                    minzoom: 0,
                    maxzoom: 19,
                    attribution:
                        '<a href="https://api.mapy.com/copyright" target="_blank">&copy; Seznam.cz a.s. a další</a>',
                },
            },
            layers: [{ id: "mapy", type: "raster", source: "mapy" }],
        },
    });
    map.touchZoomRotate.disableRotation();

    const toggle = document.getElementById("basemap-toggle")!;
    const toggleLabel = document.getElementById("basemap-toggle-label")!;

    const toggleIcon: Record<Basemap, HTMLElement> = {
        outdoor: document.getElementById("basemap-icon-aerial")!,
        aerial: document.getElementById("basemap-icon-outdoor")!,
    };

    function renderToggle() {
        // Markup ships it invisible: the stored basemap is only known here, so
        // revealing it now avoids a flash of the wrong label.
        toggle.classList.remove("invisible");
        toggleLabel.textContent = BASEMAP_LABEL[basemap];
        // Icon matches the label: plane for "Letecká", footprints for "Turistická".
        toggleIcon.outdoor.classList.toggle("hidden", basemap !== "outdoor");
        toggleIcon.aerial.classList.toggle("hidden", basemap !== "aerial");
    }

    renderToggle();
    toggle.addEventListener("click", () => {
        basemap = basemap === "outdoor" ? "aerial" : "outdoor";
        (map.getSource("mapy") as RasterTileSource).setTiles([
            tileUrl(basemap),
        ]);
        renderToggle();
        try {
            localStorage.setItem(BASEMAP_KEY, basemap);
        } catch {
            // ignore quota / privacy mode errors
        }
    });

    function currentView(): View {
        const c = map.getCenter();
        return {
            x: parseFloat(c.lng.toFixed(COORD_DECIMALS)),
            y: parseFloat(c.lat.toFixed(COORD_DECIMALS)),
            z: parseFloat(map.getZoom().toFixed(2)),
        };
    }

    function urlView(): View | null {
        const p = new URLSearchParams(window.location.search);
        return parseView(p.get("x"), p.get("y"), p.get("z"));
    }

    function viewsEqual(a: View | null, b: View | null): boolean {
        return (
            a != null && b != null && a.x === b.x && a.y === b.y && a.z === b.z
        );
    }

    let syncTimer: ReturnType<typeof setTimeout> | null = null;
    let suppressSync = false;

    function writeView(v: View, method: "push" | "replace") {
        const params = new URLSearchParams(window.location.search);
        params.set("x", String(v.x));
        params.set("y", String(v.y));
        params.set("z", String(v.z));
        const url = `${window.location.pathname}?${params.toString()}`;
        if (method === "push") history.pushState(null, "", url);
        else history.replaceState(null, "", url);
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(v));
        } catch {
            // ignore quota / privacy mode errors
        }
    }

    writeView(currentView(), "replace");

    function scheduleSync() {
        if (suppressSync) return;
        if (syncTimer != null) clearTimeout(syncTimer);
        syncTimer = setTimeout(() => {
            syncTimer = null;
            const v = currentView();
            if (viewsEqual(v, urlView())) return;
            writeView(v, "push");
        }, 200);
    }

    map.on("moveend", scheduleSync);

    window.addEventListener("popstate", () => {
        const v = urlView();
        if (!v) return;
        if (viewsEqual(v, currentView())) return;
        suppressSync = true;
        map.jumpTo({ center: [v.x, v.y], zoom: v.z });
        suppressSync = false;
        if (syncTimer != null) {
            clearTimeout(syncTimer);
            syncTimer = null;
        }
    });

    // Overlay last: a failing /api/squares must not take the map with it.
    const [geojson] = await Promise.all([
        fetch("/api/squares").then((r) => r.json()),
        map.once("load"),
    ]);
    map.addSource("squares", { type: "geojson", data: geojson });
    map.addLayer({
        id: "squares-fill",
        type: "fill",
        source: "squares",
        paint: fillPaint(),
    });
    map.addLayer({
        id: "squares-line",
        type: "line",
        source: "squares",
        paint: linePaint(),
    });
</script>
